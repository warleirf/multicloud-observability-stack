# ==========================================
# 🗄️ ZABBIX & POSTGRESQL DATABASE
# ==========================================
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=zabbix_password
POSTGRES_DB=zabbix

# ==========================================
# 📊 GRAFANA - CONFIGURAÇÕES DE ACESSO
# ==========================================
# Usuário e senha de administração do Grafana (http://localhost:3000)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ==========================================
# ☁️ AWS (AMAZON WEB SERVICES) - CLOUDWATCH
# ==========================================
# Credenciais IAM da AWS com permissão ReadOnly no CloudWatch
AWS_ACCESS_KEY_ID=sua_access_key_id_aqui
AWS_SECRET_ACCESS_KEY=sua_secret_access_key_aqui
AWS_DEFAULT_REGION=us-east-1

# ==========================================
# 🔷 AZURE (MICROSOFT AZURE) - AZURE MONITOR
# ==========================================
# Identificadores do App Registration / Service Principal no Entra ID
AZURE_TENANT_ID=seu_tenant_id_aqui
AZURE_CLIENT_ID=seu_client_id_aqui
AZURE_CLIENT_SECRET=seu_client_secret_aqui
AZURE_SUBSCRIPTION_ID=sua_subscription_id_aqui

# ==========================================
# 🟢 GCP (GOOGLE CLOUD PLATFORM) - CLOUD MONITORING
# ==========================================
# Dados da Service Account no Google Cloud
GCP_PROJECT_ID=seu_project_id_aqui
GCP_CLIENT_EMAIL=sua_service_account@seu_projeto.iam.gserviceaccount.com
# Mantenha as aspas duplas e as quebras de linha com '\n'
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_GCP_AQUI\n-----END PRIVATE KEY-----\n"

# ==========================================
# 🟠 OCI (ORACLE CLOUD INFRASTRUCTURE) - METRICS
# ==========================================
# OCIDs do Tenancy e Usuário na OCI
OCI_TENANCY_OCID=ocid1.tenancy.oc1..exemplo
OCI_USER_OCID=ocid1.user.oc1..exemplo
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx
OCI_REGION=us-ashburn-1
# Mantenha as aspas duplas e as quebras de linha com '\n'
OCI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_OCI_AQUI\n-----END RSA PRIVATE KEY-----\n"