# ==============================================================================
# MULTI-CLOUD OBSERVABILITY STACK - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para .env na raiz do projeto:
#    cp .env.example .env (ou renomeie no VS Code)
# 2. Preencha os valores abaixo com as suas credenciais reais.
# 3. NUNCA envie o arquivo .env real para o GitHub (mantenha-o no .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS POSTGRESQL (Base do Zabbix)
# ------------------------------------------------------------------------------
# Credenciais para criação e acesso ao banco relacional do Zabbix Server.
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=SubstituaPorUmaSenhaForte123!
POSTGRES_DB=zabbix

# ------------------------------------------------------------------------------
# 2. GRAFANA ADMIN
# ------------------------------------------------------------------------------
# Credenciais do usuário Administrador principal para acesso à interface web do Grafana (http://localhost:3000).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=SubstituaPorUmaSenhaSeguraGrafana123!

# ------------------------------------------------------------------------------
# 3. AMAZON WEB SERVICES (AWS CloudWatch)
# ------------------------------------------------------------------------------
# Credenciais de uma IAM User ou Role com permissão de leitura no AWS CloudWatch (ex: policy 'CloudWatchReadOnlyAccess').
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=us-east-1

# ------------------------------------------------------------------------------
# 4. MICROSOFT AZURE (Azure Monitor)
# ------------------------------------------------------------------------------
# Credenciais de um Service Principal (App Registration) no Microsoft Entra ID (Azure AD)
# com permissão de 'Reader' na assinatura desejada.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=sua_secret_gerada_no_azure_app_registration
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# ------------------------------------------------------------------------------
# 5. GOOGLE CLOUD PLATFORM (GCP Cloud Monitoring)
# ------------------------------------------------------------------------------
# Credenciais de uma Service Account no GCP com a role 'Monitoring Viewer'.
# Nota: A chave privada deve manter as quebras de linha (\n).
GCP_PROJECT_ID=meu-projeto-gcp-123456
GCP_CLIENT_EMAIL=grafana-monitoring@meu-projeto-gcp-123456.iam.gserviceaccount.com
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 6. ORACLE CLOUD INFRASTRUCTURE (OCI Metrics)
# ------------------------------------------------------------------------------
# Credenciais de API Key de um usuário OCI com permissão de leitura nos Compartments/Metrics.
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_USER_OCID=ocid1.user.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:11:22:33:44:55:66:77:88:99:00
OCI_REGION=us-ashburn-1